#!/bin/bash
set -euo pipefail

usage() {
    echo "Usage: script/version {patch|minor|major} [--dry-run]"
}

if [[ $# == 1 && ( "$1" == --help || "$1" == -h ) ]]; then
    usage
    exit 0
fi

if [[ $# -lt 1 || $# -gt 2 ]]; then
    usage >&2
    exit 2
fi

case "$1" in
    patch|minor|major) ;;
    *) usage >&2; exit 2 ;;
esac

if [[ $# == 2 && "$2" != --dry-run ]]; then
    usage >&2
    exit 2
fi

if ! cargo set-version --help >/dev/null 2>&1; then
    echo "Install cargo-edit first: cargo install cargo-edit --locked" >&2
    exit 1
fi

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
manifest="$repo_root/mysoc_validator_fast/Cargo.toml"

cargo set-version --manifest-path "$manifest" --package mysoc_validator_fast --bump "$@"

if [[ $# == 1 ]]; then
    cargo check --manifest-path "$manifest" --package mysoc_validator_fast
fi
